{
  "id": "light",
  "mode": "light",
  "$description": "The only theme measured (the page as served). Every semantic token resolves to a real foundation value.",
  "resolves": {
    "surface.default": "rgb(33,61,62)",
    "surface.alt": "rgb(238,243,243)",
    "surface.inverse": "rgb(238,243,243)",
    "surface.accent": "rgb(24,51,53)",
    "text.primary": "rgb(250,251,251)",
    "text.secondary": "rgb(169,188,188)",
    "text.inverse": "rgb(70,99,99)",
    "text.accent": "rgb(24,51,53)",
    "border.default": "rgb(247,248,248)",
    "accent.primary": "rgb(24,51,53)",
    "typography.display": {
      "fontFamily": "twkLausanne",
      "fontSize": "40px",
      "fontWeight": "350",
      "lineHeight": "48px"
    },
    "typography.heading": {
      "fontFamily": "twkLausanne",
      "fontSize": "10px",
      "fontWeight": "400",
      "lineHeight": "15px"
    },
    "typography.body": {
      "fontFamily": "twkLausanne",
      "fontSize": "16px",
      "fontWeight": "350",
      "lineHeight": "26px"
    },
    "typography.label": {
      "fontFamily": "twkLausanne",
      "fontSize": "14px",
      "fontWeight": "350",
      "lineHeight": "20px"
    },
    "radius.control": "4px",
    "radius.surface": "1px",
    "motion.duration.default": "0.2s",
    "motion.easing.default": "ease"
  }
}
