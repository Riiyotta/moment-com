{
  "version": "0.2.0",
  "derivedFrom": "templates/templates.json and sections/*.json constraints (recomputed by verify_all.py)",
  "rules": [
    {
      "id": "ONE_HERO_PER_PAGE",
      "severity": "error",
      "kind": "maxCategoryPerPage",
      "category": "HERO",
      "max": 1,
      "exceptions": [],
      "description": "A page has at most one HERO section. No measured template carries more; templates without a hero (template.careers-detail) are simply not required to have one."
    },
    {
      "id": "SECTION_PER_PAGE_LIMITS",
      "severity": "error",
      "kind": "perPageLimits",
      "limits": {
        "shell.header": 1,
        "banner.announcement": 1,
        "hero.canvas-statement": 1,
        "proof.metrics-line": 1,
        "proof.logo-strip": 1,
        "hero.memo-masthead": 1,
        "editorial.memo-part": 4,
        "editorial.memo-signoff": 1,
        "hero.title-intro": 1,
        "careers.job-group": 5,
        "hero.press-headline": 1,
        "editorial.press-meta": 1,
        "editorial.prose": 4,
        "careers.job-header": 1,
        "careers.job-description-block": 8,
        "careers.apply-cta": 1,
        "conversion.contact-dialog": 1
      },
      "description": "No section appears more often on one page than it does in any measured template."
    },
    {
      "id": "SHELL_MUST_BE_FIRST",
      "severity": "error",
      "kind": "mustBeFirst",
      "sections": [
        "shell.header"
      ],
      "description": "Sections that opened every template they appear in must be the first node."
    },
    {
      "id": "SHELL_MUST_BE_LAST",
      "severity": "error",
      "kind": "mustBeLast",
      "sections": [
        "conversion.contact-dialog"
      ],
      "description": "Sections that closed every template they appear in must be the last node (the contact dialog is the final node of every page)."
    },
    {
      "id": "NO_CONSECUTIVE_SAME_SECTION",
      "severity": "warn",
      "kind": "noConsecutive",
      "sections": [],
      "description": "These sections were never observed back-to-back. Repeatable sections (memo parts, prose blocks, job groups, description blocks) are observed back-to-back by design, so none are listed."
    },
    {
      "id": "NO_ADJACENT_SAME_CATEGORY",
      "severity": "warn",
      "kind": "noAdjacentSameCategory",
      "exceptions": [
        [
          "careers.job-description-block",
          "careers.apply-cta"
        ],
        [
          "careers.job-header",
          "careers.job-description-block"
        ],
        [
          "editorial.memo-part",
          "editorial.memo-signoff"
        ],
        [
          "editorial.press-meta",
          "editorial.prose"
        ],
        [
          "proof.metrics-line",
          "proof.logo-strip"
        ]
      ],
      "description": "Two different sections of the same category should not sit next to each other unless that exact ordered pair was observed (named exceptions, recomputed from templates)."
    },
    {
      "id": "MUST_FOLLOW_OBSERVED_PREDECESSOR",
      "severity": "error",
      "kind": "mustFollow",
      "follows": {
        "banner.announcement": [
          "shell.header"
        ],
        "careers.apply-cta": [
          "careers.job-description-block"
        ],
        "careers.job-description-block": [
          "careers.job-header"
        ],
        "careers.job-group": [
          "hero.title-intro"
        ],
        "careers.job-header": [
          "shell.header"
        ],
        "conversion.contact-dialog": [
          "careers.apply-cta",
          "careers.job-group",
          "editorial.memo-signoff",
          "editorial.prose",
          "proof.logo-strip"
        ],
        "editorial.memo-part": [
          "hero.memo-masthead"
        ],
        "editorial.memo-signoff": [
          "editorial.memo-part"
        ],
        "editorial.press-meta": [
          "hero.press-headline"
        ],
        "editorial.prose": [
          "editorial.press-meta"
        ],
        "hero.canvas-statement": [
          "banner.announcement"
        ],
        "hero.memo-masthead": [
          "banner.announcement"
        ],
        "hero.press-headline": [
          "banner.announcement"
        ],
        "hero.title-intro": [
          "banner.announcement"
        ],
        "proof.logo-strip": [
          "proof.metrics-line"
        ],
        "proof.metrics-line": [
          "hero.canvas-statement"
        ]
      },
      "description": "A section may only sit directly after a section it was observed after in a measured template (the compatibility graph's adjacency, recomputed from templates)."
    },
    {
      "id": "MOTION_BUDGET",
      "severity": "warn",
      "kind": "maxAnimatedSections",
      "max": 8,
      "description": "No page has more animated sections than the most animated measured page."
    }
  ],
  "compatibility": {
    "banner.announcement": {
      "recommendedAfter": [
