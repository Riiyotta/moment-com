  "granularityPolicy": {
    "why": "A section is the retrieval unit: it must carry one responsibility, a bounded amount of copy and imagery, and be small enough to be reused on its own. The 0.1.0 'hero.mask-intersect' (2751px desktop / 3493px mobile, 30 paragraphs, 13 images, five different responsibilities) is the case this policy forbids.",
    "maxDesktopHeightPx": 1440,
    "maxMobileHeightPx": 1688,
    "heightBasis": "1.6 x the 900px measuring viewport (desktop) and 2 x the 844px measuring viewport (mobile)",
    "maxCopyCapacityWords": 1500,
    "maxImageCapacity": 8,
    "maxBodyItemCapacity": 16,
    "maxContentFields": 6,
    "genericIdLeaves": [
      "block",
      "section",
      "container",
      "wrapper",
      "group",
      "mask-intersect",
      "pointer-events-none",
      "w-full",
      "content",
      "div"
    ]
  },
  "retiredSectionIds": {
    "hero.mask-intersect": "split by page region: hero.canvas-statement, proof.metrics-line, proof.logo-strip, hero.title-intro, careers.job-group, hero.press-headline, editorial.press-meta, editorial.prose, careers.job-header, careers.job-description-block, careers.apply-cta, conversion.contact-dialog",
    "content.block": "renamed banner.announcement (it is the announcement strip, and it holds two links, not one)",
    "content.section": "split: hero.memo-masthead, editorial.memo-part, editorial.memo-signoff",
    "features.section": "was memo Part IV ('The End of Tools'): now an editorial.memo-part"
  },
  "retiredTemplateIds": {
    "template.group": "split by page family: template.home, template.careers-index, template.press-release",
    "template.careers": "renamed template.careers-detail (template.careers-index is the listing page)"
  }
