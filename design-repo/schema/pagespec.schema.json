{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PageSpec",
  "description": "A page composition. Styling is owned by section/component contracts; a PageSpec carries no style or token-override field.",
  "type": "object",
  "required": [
    "pageSpecVersion",
    "template",
    "route",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "pageSpecVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "template": {
      "type": "string",
      "enum": [
        "template.home",
        "template.memo",
        "template.careers-index",
        "template.press-release",
        "template.careers-detail"
      ]
    },
    "route": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "assetRole": {
      "type": "string",
      "enum": [
        "logo",
        "customer-logo",
        "avatar",
        "icon",
        "illustration",
        "background",
        "hero-image",
        "content-image",
        "animation",
        "video",
        "font",
        "live-embed",
        "founder-contact-email",
        "partner-logo",
        "author-photo",
        "product-screenshot",
        "editorial-illustration",
        "social-card"
      ]
    },
    "motion": {
      "type": "object",
      "required": [
        "pattern",
        "reducedMotionFallback"
      ],
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string",
          "enum": [
            "none",
            "css-transition",
            "css-animation",
            "appear-on-enter",
            "scroll-linked",
            "canvas-animation"
          ]
        },
        "reducedMotionFallback": {
          "type": "string",
          "enum": [
            "disable-animation",
            "instant-state"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "type",
        "content",
        "motion"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "banner.announcement",
            "careers.apply-cta",
            "careers.job-description-block",
            "careers.job-group",
            "careers.job-header",
            "conversion.contact-dialog",
            "editorial.memo-part",
            "editorial.memo-signoff",
            "editorial.press-meta",
            "editorial.prose",
            "hero.canvas-statement",
            "hero.memo-masthead",
            "hero.press-headline",
            "hero.title-intro",
            "proof.logo-strip",
            "proof.metrics-line",
            "shell.header"
          ]
        },
        "content": {
          "type": "object"
        },
        "motion": {
          "$ref": "#/definitions/motion"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "banner.announcement"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.banner.announcement"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "careers.apply-cta"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.careers.apply-cta"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "careers.job-description-block"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.careers.job-description-block"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "careers.job-group"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.careers.job-group"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "careers.job-header"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.careers.job-header"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "conversion.contact-dialog"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.conversion.contact-dialog"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "editorial.memo-part"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.editorial.memo-part"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "editorial.memo-signoff"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.editorial.memo-signoff"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "editorial.press-meta"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.editorial.press-meta"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "editorial.prose"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.editorial.prose"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hero.canvas-statement"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.hero.canvas-statement"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hero.memo-masthead"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.hero.memo-masthead"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hero.press-headline"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.hero.press-headline"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hero.title-intro"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.hero.title-intro"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "proof.logo-strip"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.proof.logo-strip"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "proof.metrics-line"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.proof.metrics-line"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "shell.header"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.shell.header"
              }
            }
          }
        }
      ]
    },
    "assetRoleSource": {
      "type": "string",
      "enum": [
        "placeholder",
        "supplied"
      ],
      "description": "Required for protected roles (logos, people, screenshots, live endpoints): 'placeholder' = an explicit placeholder; 'supplied' = a real file the user provided. A generator may not fabricate either kind."
    },
    "content.banner.announcement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 7
          }
        },
        "ctas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxWords": 5
              },
              "href": {
                "type": "string",
                "pattern": "^(/|#)",
                "description": "Relative path or #anchor only: generated pages must not link to the original site's live URLs."
              }
            }
          },
          "maxItems": 2
        }
      },
      "required": [
        "body",
        "ctas"
      ]
    },
    "content.careers.apply-cta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 4
          }
        },
        "ctas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxWords": 4
              },
              "href": {
                "type": "string",
                "pattern": "^(/|#)",
                "description": "Relative path or #anchor only: generated pages must not link to the original site's live URLs."
              }
            }
          },
          "maxItems": 1
        }
      },
      "required": [
        "body",
        "ctas"
      ]
    },
    "content.careers.job-description-block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 8
        },
        "body": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 77
          }
        }
      },
      "required": [
        "body"
      ]
    },
    "content.careers.job-group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 5
        },
        "items": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxWords": 6
              }
            }
          }
        }
      },
      "required": [
        "heading",
        "items"
      ]
    },
    "content.careers.job-header": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 6
        },
        "subheading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 5
        },
        "ctas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxWords": 1
              },
              "href": {
                "type": "string",
                "pattern": "^(/|#)",
                "description": "Relative path or #anchor only: generated pages must not link to the original site's live URLs."
              }
            }
          },
          "maxItems": 2
        },
        "items": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxWords": 2
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxWords": 3
              }
            }
          }
        }
      },
      "required": [
        "heading",
        "subheading",
        "ctas",
        "items"
      ]
    },
    "content.conversion.contact-dialog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 3
        },
        "ctas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxWords": 1
              },
              "href": {
                "type": "string",
                "pattern": "^(/|#)",
                "description": "Relative path or #anchor only: generated pages must not link to the original site's live URLs."
              }
            }
          },
          "maxItems": 1
        },
        "items": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxWords": 6
              }
            }
          }
        }
      },
      "required": [
        "heading",
        "ctas",
        "items"
      ]
    },
    "content.editorial.memo-part": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 4
        },
        "subheading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 3
        },
        "body": {
          "type": "array",
          "maxItems": 11,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 70
          }
        }
      },
      "required": [
        "heading",
        "subheading",
        "body"
      ]
    },
    "content.editorial.memo-signoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 1
        },
        "body": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 7
          }
        }
      },
      "required": [
