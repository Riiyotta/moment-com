{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PageSpec",
  "description": "A page composition. Styling is owned by section/component contracts; a PageSpec carries no style or token-override field.",
  "type": "object",
  "required": [
    "pageSpecVersion",
    "template",
    "route",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "pageSpecVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "template": {
      "type": "string",
      "enum": [
        "template.group",
        "template.memo",
        "template.careers"
      ]
    },
    "route": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "assetRole": {
      "type": "string",
      "enum": [
        "logo",
        "customer-logo",
        "avatar",
        "icon",
        "illustration",
        "background",
        "hero-image",
        "content-image",
        "animation",
        "video",
        "font",
        "live-embed",
        "founder-contact-email"
      ]
    },
    "motion": {
      "type": "object",
      "required": [
        "pattern",
        "reducedMotionFallback"
      ],
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string",
          "enum": [
            "none",
            "css-transition",
            "css-animation",
            "appear-on-enter",
            "scroll-linked",
            "canvas-animation"
          ]
        },
        "reducedMotionFallback": {
          "type": "string",
          "enum": [
            "disable-animation",
            "instant-state"
          ]
        }
      }
    },
    "content.content.block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 7
          }
        },
        "ctas": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxWords": 5
              },
              "href": {
                "type": "string",
                "pattern": "^(/|#)",
                "description": "Relative path or #anchor only: generated pages must not link to the original site's live URLs."
              }
            }
          }
        }
      },
      "required": [
        "body"
      ]
    },
    "content.content.section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 3
        },
        "body": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 70
          }
        }
      },
      "required": [
        "body"
      ]
    },
    "content.features.section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 4
        },
        "body": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 40
          }
        }
      },
      "required": [
        "heading",
        "body"
      ]
    },
    "content.hero.mask-intersect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 17
        },
        "subheading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 6
        },
        "body": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 80
          }
        },
        "ctas": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxWords": 4
              },
              "href": {
                "type": "string",
                "pattern": "^(/|#)",
                "description": "Relative path or #anchor only: generated pages must not link to the original site's live URLs."
              }
            }
          }
        },
        "items": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxWords": 9
              }
            }
          }
        },
        "images": {
          "type": "array",
          "maxItems": 13,
          "items": {
            "type": "object",
            "required": [
              "assetRole"
            ],
            "additionalProperties": false,
            "properties": {
              "assetRole": {
                "$ref": "#/definitions/assetRole"
              },
              "alt": {
                "type": "string",
                "maxWords": 16
              }
            }
          }
        }
      },
      "required": [
        "heading",
        "body"
      ]
    },
    "content.shell.header": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 3
          }
        },
        "ctas": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxWords": 2
              },
              "href": {
                "type": "string",
                "pattern": "^(/|#)",
                "description": "Relative path or #anchor only: generated pages must not link to the original site's live URLs."
              }
            }
          }
        }
      },
      "required": [
        "body",
        "ctas"
      ]
    },
    "node": {
      "type": "object",
      "required": [
        "type",
        "content",
        "motion"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "content.block",
            "content.section",
            "features.section",
            "hero.mask-intersect",
            "shell.header"
          ]
        },
        "content": {
          "type": "object"
        },
        "motion": {
          "$ref": "#/definitions/motion"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "content.block"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.content.block"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "content.section"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.content.section"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "features.section"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.features.section"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hero.mask-intersect"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.hero.mask-intersect"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "shell.header"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.shell.header"
              }
            }
          }
        }
      ]
    }
  }
}
